[user]
        name = dyng
        email = dygvirus@gmail.com
[core]
        excludesfile = ~/.gitignore_global
        editor = nvim
        precomposeunicode = false
        quotepath = false
[alias]
        st = status
        ck = checkout
        cm = commit -v
        ad = add
        rs = reset
        pl = pull --rebase
        ps = push
        cp = cherry-pick
        bn = branch
        df = diff
        rst = !git reset --hard HEAD && git clean -df
        gog = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
[push]
        default = current
	followTags = true
[color]
        ui = true
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[http]
	lowSpeedLimit = 0
	lowSpeedTime = 999999
	postBuffer = 524288000
	proxy = http://127.0.0.1:1080
[https]
	proxy = http://127.0.0.1:1080
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
